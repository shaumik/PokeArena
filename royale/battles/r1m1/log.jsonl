{"n":8,"turn":6,"phase":"choosing","actions":["switched to Jolteon  // Alakazam is at 16 and Slowbro now outspeeds it through paralysis — I refuse to feed a Pokemon for nothing. Jolteon comes in on a 4x-relevant matchup with Specs Thunderbolt aimed at Slowbro's head.","Slowbro used Scald  // Full paralysis. That is the Thunder Wave from turn one still collecting rent six turns later. Scald again to close it out before Shadow Ball gets a say."],"lines":[{"type":"turn","side":-1,"text":"— Turn 7 —"},{"type":"switch","side":0,"text":"Alakazam, come back!"},{"type":"switch","side":0,"text":"Go, Jolteon!"},{"type":"move","side":1,"text":"Slowbro used Scald!"},{"type":"damage","side":0,"text":"Jolteon took 55 damage."}],"after":{"turn":7,"phase":"choosing","sides":[{"trainer":"Hairtrigger","team":[{"name":"Alakazam","hp":16,"max_hp":131,"status":"paralysis"},{"name":"Jolteon","hp":86,"max_hp":141,"active":true},{"name":"Aerodactyl","hp":156,"max_hp":156},{"name":"Dugtrio","hp":111,"max_hp":111},{"name":"Electrode","hp":136,"max_hp":136},{"name":"Starmie","hp":136,"max_hp":136}],"hazards":"none","screens":"none"},{"trainer":"The Bulwark","team":[{"name":"Chansey","hp":0,"max_hp":357,"fainted":true},{"name":"Clefable","hp":70,"max_hp":202},{"name":"Slowbro","hp":202,"max_hp":202,"active":true},{"name":"Weezing","hp":172,"max_hp":172},{"name":"Tentacruel","hp":187,"max_hp":187},{"name":"Vaporeon","hp":237,"max_hp":237}],"hazards":"none","screens":"none"}]},"winner":-1}
{"n":9,"turn":7,"phase":"choosing","actions":["Jolteon used Thunderbolt  // Backing out Scald's damage puts Slowbro's Sp.Atk near base — this is a pure wall, so its Sp.Def is bare too. Specs Thunderbolt at double effectiveness is a clean one-shot; Regenerator never gets to undo it.","switched to Tentacruel  // Slowbro is water staring down an electric type — that is a trade, and I do not trade. Tentacruel eats the Thunderbolt through 189 special defense despite the weakness, which is the whole point of building a wall instead of a resist."],"lines":[{"type":"turn","side":-1,"text":"— Turn 8 —"},{"type":"switch","side":1,"text":"Slowbro, come back!"},{"type":"switch","side":1,"text":"Go, Tentacruel!"},{"type":"move","side":0,"text":"Jolteon used Thunderbolt!"},{"type":"damage","side":1,"text":"Tentacruel took 139 damage."},{"type":"effective","side":0,"text":"It's super effective!"},{"type":"item","side":1,"text":"Tentacruel ate its Sitrus Berry!"},{"type":"item","side":1,"text":"Tentacruel restored a little HP (Sitrus Berry, +46)."}],"after":{"turn":8,"phase":"choosing","sides":[{"trainer":"Hairtrigger","team":[{"name":"Alakazam","hp":16,"max_hp":131,"status":"paralysis"},{"name":"Jolteon","hp":86,"max_hp":141,"active":true},{"name":"Aerodactyl","hp":156,"max_hp":156},{"name":"Dugtrio","hp":111,"max_hp":111},{"name":"Electrode","hp":136,"max_hp":136},{"name":"Starmie","hp":136,"max_hp":136}],"hazards":"none","screens":"none"},{"trainer":"The Bulwark","team":[{"name":"Chansey","hp":0,"max_hp":357,"fainted":true},{"name":"Clefable","hp":70,"max_hp":202},{"name":"Slowbro","hp":202,"max_hp":202},{"name":"Weezing","hp":172,"max_hp":172},{"name":"Tentacruel","hp":94,"max_hp":187,"active":true},{"name":"Vaporeon","hp":237,"max_hp":237}],"hazards":"none","screens":"none"}]},"winner":-1}
