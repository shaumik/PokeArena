{"n":17,"turn":13,"phase":"choosing","actions":["Jolteon used Thunderbolt  // Unaware saved Clefable from my boosts but not from raw Specs power. It sits at ~71 HP, Thunderbolt rolls 79-93, and at 200 speed it never gets to Soft-Boiled. Rocky Helmet is irrelevant to a special hit.","Clefable used Protect  // Clefable at 70 cannot outheal a Specs Thunderbolt and cannot outrun one, so it does the only thing left: refuse. Protect is free, it is certain, and it forces them to keep spending turns on a Pokémon they cannot touch."],"lines":[{"type":"turn","side":-1,"text":"— Turn 14 —"},{"type":"move","side":1,"text":"Clefable used Protect!"},{"type":"status","side":1,"text":"Clefable protected itself!"},{"type":"move","side":0,"text":"Jolteon used Thunderbolt!"},{"type":"protect","side":1,"text":"Clefable protected itself!"}],"after":{"turn":14,"phase":"choosing","sides":[{"trainer":"Hairtrigger","team":[{"name":"Alakazam","hp":16,"max_hp":131,"status":"paralysis"},{"name":"Jolteon","hp":86,"max_hp":141,"active":true},{"name":"Aerodactyl","hp":156,"max_hp":156},{"name":"Dugtrio","hp":111,"max_hp":111},{"name":"Electrode","hp":136,"max_hp":136},{"name":"Starmie","hp":136,"max_hp":136}],"hazards":"none","screens":"none"},{"trainer":"The Bulwark","team":[{"name":"Chansey","hp":0,"max_hp":357,"fainted":true},{"name":"Clefable","hp":70,"max_hp":202,"active":true},{"name":"Slowbro","hp":202,"max_hp":202},{"name":"Weezing","hp":0,"max_hp":172,"fainted":true},{"name":"Tentacruel","hp":94,"max_hp":187},{"name":"Vaporeon","hp":0,"max_hp":237,"fainted":true}],"hazards":"none","screens":"none"}]},"winner":-1}
{"n":18,"turn":14,"phase":"choosing","actions":["Jolteon used Thunderbolt  // Protect is now only 33% to repeat, so swinging is two-to-one in my favour. And stalling is a losing plan for them anyway — at the turn cap I win the count 6-3. Fire.","switched to Tentacruel  // Cold triage. Every body I own dies to one Thunderbolt, so the question is not who I save but what order I spend them in. Tentacruel has no recovery move — it can never anchor a stall — so it buys the turn, and switching resets Clefable's Protect back to a guaranteed 100% for later."],"lines":[{"type":"turn","side":-1,"text":"— Turn 15 —"},{"type":"switch","side":1,"text":"Clefable, come back!"},{"type":"switch","side":1,"text":"Go, Tentacruel!"},{"type":"move","side":0,"text":"Jolteon used Thunderbolt!"},{"type":"damage","side":1,"text":"Tentacruel took 94 damage."},{"type":"effective","side":0,"text":"It's super effective!"},{"type":"faint","side":1,"text":"Tentacruel fainted!"}],"after":{"turn":15,"phase":"replace","sides":[{"trainer":"Hairtrigger","team":[{"name":"Alakazam","hp":16,"max_hp":131,"status":"paralysis"},{"name":"Jolteon","hp":86,"max_hp":141,"active":true},{"name":"Aerodactyl","hp":156,"max_hp":156},{"name":"Dugtrio","hp":111,"max_hp":111},{"name":"Electrode","hp":136,"max_hp":136},{"name":"Starmie","hp":136,"max_hp":136}],"hazards":"none","screens":"none"},{"trainer":"The Bulwark","team":[{"name":"Chansey","hp":0,"max_hp":357,"fainted":true},{"name":"Clefable","hp":70,"max_hp":202},{"name":"Slowbro","hp":202,"max_hp":202},{"name":"Weezing","hp":0,"max_hp":172,"fainted":true},{"name":"Tentacruel","hp":0,"max_hp":187,"fainted":true,"active":true},{"name":"Vaporeon","hp":0,"max_hp":237,"fainted":true}],"hazards":"none","screens":"none"}]},"winner":-1}
