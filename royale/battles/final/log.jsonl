{"n":24,"turn":15,"phase":"choosing","actions":["Alakazam used Psychic  // Solar Power cuts both ways: it costs Charizard an eighth of itself every turn the sun is up. Alakazam is at 32 and dies here no matter what it clicks, so it clicks the biggest number it owns — 140 — and leaves Charizard for its own ability to finish. Dugtrio's Rock Slide is four times effective on what is left.","Charizard used Solar Beam  // Solar Beam under Drought is a one-turn, hundred-percent-accurate move that kills Alakazam where it stands and is double-effective on the Dugtrio behind it — the same click covers the stay and the switch. This is the move the entire team was assembled to make, and it is fitting it gets thrown on the last Pokémon standing."],"lines":[{"type":"turn","side":-1,"text":"— Turn 16 —"},{"type":"move","side":0,"text":"Alakazam used Psychic!"},{"type":"damage","side":1,"text":"Charizard took 134 damage."},{"type":"move","side":1,"text":"Charizard took in sunlight!"},{"type":"move","side":1,"text":"Charizard used Solar Beam!"},{"type":"damage","side":0,"text":"Alakazam took 32 damage."},{"type":"faint","side":0,"text":"Alakazam fainted!"},{"type":"weather","side":-1,"text":"The sunlight is strong."},{"type":"ability","side":1,"text":"Charizard was hurt by Solar Power! (-19)"}],"after":{"turn":16,"phase":"replace","weather":"sun(2)","sides":[{"trainer":"Hairtrigger","team":[{"name":"Alakazam","hp":0,"max_hp":131,"fainted":true,"active":true},{"name":"Jolteon","hp":0,"max_hp":141,"fainted":true},{"name":"Aerodactyl","hp":0,"max_hp":156,"fainted":true},{"name":"Dugtrio","hp":111,"max_hp":111},{"name":"Electrode","hp":0,"max_hp":136,"fainted":true},{"name":"Starmie","hp":0,"max_hp":136,"fainted":true}],"hazards":"none","screens":"none"},{"trainer":"Solaris","team":[{"name":"Ninetales","hp":31,"max_hp":149},{"name":"Venusaur","hp":0,"max_hp":156,"fainted":true},{"name":"Victreebel","hp":0,"max_hp":156,"fainted":true},{"name":"Exeggutor","hp":0,"max_hp":171,"fainted":tru