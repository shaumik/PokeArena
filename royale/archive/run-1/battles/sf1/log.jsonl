{"n":22,"turn":16,"phase":"choosing","actions":["switched to Victreebel  // Raticate is on 16 HP burning 8 a turn — it dies to its own Flame Orb at the end of turn 17 whether I attack it or not, so I refuse to trade anything real for it. Victreebel is on 1 HP and is my least valuable asset; it eats the Guts Crunch instead of Exeggutor or Charizard, and Charizard then enters clean at full HP for Arbok, which cannot touch a Flying-type with Earthquake.","Raticate used Facade  // Flame Orb lit, so Guts is live and Facade doubles to 140 off my own burn. Against a -1 Defence Exeggutor on 94 HP that is roughly 267 - and the same click OHKOs Charizard, Arcanine, Venusaur or Victreebel if they pivot instead."],"lines":[{"type":"turn","side":-1,"text":"— Turn 17 —"},{"type":"switch","side":0,"text":"Exeggutor, come back!"},{"type":"switch","side":0,"text":"Go, Victreebel!"},{"type":"move","side":1,"text":"Raticate used Facade!"},{"type":"damage","side":0,"text":"Victreebel took 1 damage."},{"type":"faint","side":0,"text":"Victreebel fainted!"},{"type":"weather","side":-1,"text":"The sunlight is strong."},{"type":"status","side":1,"text":"Raticate is hurt by its burn! (-8)"}],"after":{"turn":17,"phase":"replace","weather":"sun(1)","sides":[{"trainer":"Solaris","team":[{"name":"Ninetales","hp":0,"max_hp":149,"fainted":true},{"name":"Venusaur","hp":33,"max_hp":156},{"name":"Victreebel","hp":0,"max_hp":156,"fainted":true,"active":true},{"name":"Exeggutor","hp":94,"max_hp":171,"status":"paralysis"},{"name":"Charizard","hp":154,"max_hp":154},{"name":"Arcanine","hp":67,"max_hp":166}],"hazards":"none","screens":"none"},{"trainer":"The Apothecary","team":[{"name":"Jynx","hp":0,"max_hp":141,"fainted":true},{"name":"Gengar","hp":0,"max_hp":136,"fainted":true},{"name":"Zapdos","hp":0,"max_hp":197,"fainted":true},{"name":"Arbok","hp":167,"max_hp":167},{"name":"Raticate","hp":8,"max_hp":131,"status":"burn","active":true},{"name":"Golbat","hp":0,"max_hp":182,"fainted":true}],"hazards":"non