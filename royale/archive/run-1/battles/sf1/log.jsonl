{"n":23,"turn":17,"phase":"replace","actions":["switched to Charizard  // Charizard enters clean and at full HP, exactly as the sacrifice was meant to buy. It outspeeds Raticate 167 to 163, so it can finish the 8-HP rat before the Guts Facade lands, and it is flatly immune to Arbok's Earthquake afterwards.",""],"lines":[{"type":"switch","side":0,"text":"Go, Charizard!"}],"after":{"turn":17,"phase":"choosing","weather":"sun(1)","sides":[{"trainer":"Solaris","team":[{"name":"Ninetales","hp":0,"max_hp":149,"fainted":true},{"name":"Venusaur","hp":33,"max_hp":156},{"name":"Victreebel","hp":0,"max_hp":156,"fainted":true},{"name":"Exeggutor","hp":94,"max_hp":171,"status":"paralysis"},{"name":"Charizard","hp":154,"max_hp":154,"active":true},{"name":"Arcanine","hp":67,"max_hp":166}],"hazards":"none","screens":"none"},{"trainer":"The Apothecary","team":[{"name":"Jynx","hp":0,"max_hp":141,"fainted":true},{"name":"Gengar","hp":0,"max_hp":136,"fainted":true},{"name":"Zapdos","hp":0,"max_hp":197,"fainted":true},{"name":"Arbok","hp":167,"max_hp":167},{"name":"Raticate","hp":8,"max_hp":131,"status":"burn","active":true},{"name":"Golbat","hp":0,"max_hp":182,"fainted":true}],"hazards":"none","screens":"none"}]},"winner":-1}
{"n":24,"turn":17,"phase":"choosing","actions":["Charizard used Air Slash  // Air Slash is overkill on an 8-HP Raticate and 95% accurate, so it closes this without spending scarce Fire Blast PP on a rounding error. And it is the right button even if they flee to Arbok, since Flying is 2x on a pure Poison-type.","switched to Arbok  // Charizard outruns Raticate so Facade can never land, and switching also parks the burn - residuals only tick on the active mon. Exeggutor OHKOs Arbok and Arbok can never beat it, so preserving Raticate's guaranteed Facade KO is worth the Air Slash Arbok eats coming in."],"lines":[{"type":"turn","side":-1,"text":"— Turn 18 —"},{"type":"switch","side":1,"text":"Raticate, come back!"},{"type":"switch","side":1,"text":"Go, Arbok!"},{"type":"ability","side":1,"text":"Arbok's Intimidate cuts Charizard's Attack!"},{"type":"stat","side":0,"text":"Charizard's Attack fell!"},{"type":"move","side":0,"text":"Charizard used Air Slash!"},{"type":"damage","side":1,"text":"Arbok took 167 damage."},{"type":"crit","side":0,"text":"A critical hit!"},{"type":"faint","side":1,"text":"Arbok fainted!"},{"type":"weather","side":-1,"text":"The sunlight faded."}],"after":{"turn":18,"phase":"replace","sides":[{"trainer":"Solaris","team":[{"name":"Ninetales","hp":0,"max_hp":149,"fainted":true},{"name":"Venusaur","hp":33,"max_hp":156},{"name":"Victreebel","hp":0,"max_hp":156,"fainted":true},{"name":"Exeggutor","hp":94,"max_hp":171,"status":"paralysis"},{"name":"Charizard","hp":154,"max_hp":154,"active":true},{"name":"Arcanine","hp":67,"max_hp":166}],"hazards":"none","screens":"none"},{"trainer":"The Apothecary","team":[{"name":"Jynx","hp":0,"max_hp":141,"fainted":true},{"name":"Gengar","hp":0,"max_hp":136,"fainted":true},{"name":"Zapdos","hp":0,"max_hp":197,"fainted":true},{"name":"Arbok","hp":0,"max_hp":167,"fainted":true,"active":true},{"name":"Raticate","hp":8,"max_hp":131,"status":"burn"},{"name":"Golbat","hp":0,"max_hp":182,"fainted":true}],"hazards":"none","s