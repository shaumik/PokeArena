{"n":1,"turn":0,"phase":"choosing","actions":["Ninetales used Fire Blast  // Drought is already up, so this Fire Blast is sun-boosted and 2x on Ice/Psychic. Jynx's Sash means it gets one action whatever I do, so I take the action that leaves it on 1 HP rather than the one that leaves me at +2 and asleep.","Jynx used Lovely Kiss  // Jynx outspeeds Ninetales at 161. Their sun is a fixed 8-turn clock, not a state I can dispel - so I make them spend it asleep. Focus Sash covers the 25% miss."],"lines":[{"type":"turn","side":-1,"text":"— Turn 1 —"},{"type":"ability","side":0,"text":"Ninetales's ability set the weather!"},{"type":"weather","side":-1,"text":"The sunlight turned harsh!"},{"type":"move","side":0,"text":"Ninetales used Fire Blast!"},{"type":"damage","side":1,"text":"Jynx took 140 damage."},{"type":"item","side":1,"text":"Jynx hung on with its Focus Sash!"},{"type":"effective","side":0,"text":"It's super effective!"},{"type":"move","side":1,"text":"Jynx used Lovely Kiss!"},{"type":"status","side":0,"text":"Ninetales was put to sleep!"},{"type":"weather","side":-1,"text":"The sunlight is strong."}],"after":{"turn":1,"phase":"choosing","weather":"sun(7)","sides":[{"trainer":"Solaris","team":[{"name":"Ninetales","hp":149,"max_hp":149,"status":"sleep","active":true},{"name":"Venusaur","hp":156,"max_hp":156},{"name":"Victreebel","hp":156,"max_hp":156},{"name":"Exeggutor","hp":171,"max_hp":171},{"name":"Charizard","hp":154,"max_hp":154},{"name":"Arcanine","hp":166,"max_hp":166}],"hazards":"none","screens":"none"},{"trainer":"The Apothecary","team":[{"name":"Jynx","hp":1,"max_hp":141,"active":true},{"name":"Gengar","hp":136,"max_hp":136},{"name":"Zapdos","hp":197,"max_hp":197},{"name":"Arbok","hp":167,"max_hp":167},{"name":"Raticate","hp":131,"max_hp":131},{"name":"Golbat","hp":182,"max_hp":182}],"hazards":"none","screens":"none"}]},"winner":-1}
{"n":2,"turn":1,"phase":"choosing","actions":["switched to Arcanine  // Pivoting the sleeping Ninetales out resets its sleep counter, so the nap costs me one turn instead of three. Arcanine resists Ice Beam, brings Intimidate, and nothing on their roster resists a sun-boosted Choice Band Flare Blitz.","Jynx used Psychic  // Jynx is a dead body walking at 1 HP, so I spend its last action on damage. Psychic hits a sleeping Ninetales for ~58% and is 2x on Venusaur or Victreebel if they pivot."],"lines":[{"type":"turn","side":-1,"text":"— Turn 2 —"},{"type":"switch","side":0,"text":"Ninetales, come back!"},{"type":"switch","side":0,"text":"Go, Arcanine!"},{"type":"ability","side":0,"text":"Arcanine's Intimidate cuts Jynx's Attack!"},{"type":"stat","side":1,"text":"Jynx's Attack fell!"},{"type":"move","side":1,"text":"Jynx used Psychic!"},{"type":"damage","side":0,"text":"Arcanine took 99 damage."},{"type":"weather","side":-1,"text":"The sunlight is strong."}],"after":{"turn":2,"phase":"choosing","weather":"sun(6)","sides":[{"trainer":"Solaris","team":[{"name":"Ninetales","hp":149,"max_hp":149,"status":"sleep"},{"name":"Venusaur","hp":156,"max_hp":156},{"name":"Victreebel","hp":156,"max_hp":156},{"name":"Exeggutor","hp":171,"max_hp":171},{"name":"Charizard","hp":154,"max_hp":154},{"name":"Arcanine","hp":67,"max_hp":166,"active":true}],"hazards":"none","screens":"none"},{"trainer":"The Apothecary","team":[{"name":"Jynx","hp":1,"max_hp":141,"active":true},{"name":"Gengar","hp":136,"max_hp":136},{"name":"Zapdos","hp":197,"max_hp":197},{"name":"Arbok","hp":167,"max_hp":167},{"name":"Raticate","hp":131,"max_hp":131},{"name":"Golbat","hp":182,"max_hp":182}],"hazards":"none","screens":"none"}]},"winner":-1}
{"n":3,"turn":2,"phase":"choosing","actions":["Arcanine used Extreme Speed  // Jynx outspeeds and its Psychic already did 99 to a 67-HP Arcanine, so any non-priority move loses Arcanine for nothing. Extreme Speed at +2 removes their fastest special attacker and their only sleep move before it can fire again.","Jynx used Psychic  // Arcanine at 39% is inside Psychic's roll. Trading a 1 HP Jynx whose Lovely Kiss is sleep-clause-locked for a Choice Band sun attacker is a bargain even if Extreme Speed beats me to it."],"lines":[{"type":"turn","side":-1,"text":"— Turn 3 —"},{"type":"move","side":0,"text":"Arcanine used Extreme Speed!"},{"type":"damage","side":1,"text":"Jynx took 1 damage."},{"type":"faint","side":1,"text":"Jynx fainted!"},{"type":"weather","side":-1,"text":"The sunlight is strong."}],"after":{"turn":3,"phase":"replace","weather":"sun(5)","sides":[{"trainer":"Solaris","team":[{"name":"Ninetales","hp":149,"max_hp":149,"status":"sleep"},{"name":"Venusaur","hp":156,"max_hp":156},{"name":"Victreebel","hp":156,"max_hp":156},{"name":"Exeggutor","hp":171,"max_hp":171},{"name":"Charizard","hp":154,"max_hp":154},{"name":"Arcanine","hp":67,"max_hp":166,"active":true}],"hazards":"none","screens":"none"},{"trainer":"The Apothecary","team":[{"name":"Jynx","hp":0,"max_hp":141,"fainted":true,"active":true},{"name":"Gengar","hp":136,"max_hp":136},{"name":"Zapdos","hp":197,"max_hp":197},{"name":"Arbok","hp":167,"max_hp":167},{"name":"Raticate","hp":131,"max_hp":131},{"name":"Golbat","hp":182,"max_hp":182}],"hazards":"none","screens":"none"}]},"winner":-1}
