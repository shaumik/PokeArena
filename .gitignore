/reports/

# editor / os
.DS_Store
.idea/
.vscode/

# claude code local settings
.claude/
bin/

# antigravity CLI local symlinks
.antigravitycli/

# royale broker transients: the lock is a running process's mutex and the
# digest is derived (python3 royale/digest.py rebuilds it from battles/)
royale/battles/*/lock
royale/battles/*/*.tmp
royale/tournament.json
royale/battles/*/pending.json

# referee agents drop temporary engine probes here while auditing a match
internal/engine/zz_judge_probe_test.go
__pycache__/
*.pyc

# The Showdown port's per-case outcome dump (make test-showdown-report).
# Regenerated on every run and read by cmd/showdown-triage; the reviewed form
# of the same information is the gaps ledger and docs/showdown-findings.md.
showdown-report.json
