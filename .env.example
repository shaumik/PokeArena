# ---- gateway ----
GATEWAY_ADDR=:8080

# ---- postgres (system of record) ----
DATABASE_URL=postgres://pokearena:pokearena@postgres:5432/pokearena?sslmode=disable

# ---- redis (live state + cache + leaderboard) ----
REDIS_URL=redis://redis:6379/0

# ---- rabbitmq (work + events) ----
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ---- battle / ai tuning ----
AI_DIFFICULTY=hard          # easy | hard | nightmare
AI_TIME_BUDGET_MS=1500      # per-decision budget for the harness (paired with maxDepth=3)
DATA_VERSION=gen1-v1        # namespaces the dataset + caches

# ---- optional: LLM "nightmare" agent ----
# leave blank to disable nightmare entirely (requests for it are rejected
# at the API and AI_DIFFICULTY=nightmare refuses to boot)
ANTHROPIC_API_KEY=
